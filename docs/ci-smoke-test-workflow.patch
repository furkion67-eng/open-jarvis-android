+
+  smoke-test:
+    name: Emulator launch smoke test (Android 13)
+    runs-on: ubuntu-latest
+    needs: build
+    timeout-minutes: 30
+    steps:
+      - name: Checkout repository
+        uses: actions/checkout@v4
+
+      - name: Download app APK
+        uses: actions/download-artifact@v4
+        with:
+          name: Open-Jarvis-APK
+          path: apk
+
+      - name: Download instrumented test APK
+        uses: actions/download-artifact@v4
+        with:
+          name: Open-Jarvis-Test-APK
+          path: apk-tests
+
+      - name: Set up JDK 17
+        uses: actions/setup-java@v4
+        with:
+          distribution: temurin
+          java-version: '17'
+
+      - name: Enable KVM access
+        run: |
+          echo 'KERNEL=="kvm", GROUP="kvm", MODE="0666", OPTIONS+="static_node=kvm"' | sudo tee /etc/udev/rules.d/99-kvm4all.rules
+          sudo udevadm control --reload-rules
+          sudo udevadm trigger --name-match=kvm
+          ls -la /dev/kvm
+
+      - name: Ensure sqlite3 is available
+        run: |
+          if ! command -v sqlite3 >/dev/null 2>&1; then
+            sudo apt-get update && sudo apt-get install -y sqlite3
+          fi
+          sqlite3 --version
+
+      - name: Boot Android 13 emulator and run launch smoke scenarios
+        uses: reactivecircus/android-emulator-runner@v2
+        env:
+          APP_APK: apk/app-debug.apk
+          TEST_APK: apk-tests/app-debug-androidTest.apk
+        with:
+          api-level: 33
+          target: google_apis
+          arch: x86_64
+          script: bash scripts/smoke_test.sh
+
+      - name: Upload smoke-test evidence
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: Open-Jarvis-Smoke-Test
+          path: |
+            screen-*.png
+            crashlog.txt
+            logcat-full.txt
+            instrumented.log
+            databases.txt
+          if-no-files-found: warn
+          retention-days: 7
